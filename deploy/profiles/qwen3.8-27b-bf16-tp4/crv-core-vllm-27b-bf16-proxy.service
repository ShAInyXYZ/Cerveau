[Unit]
Description=Cerveau Brain Core — socket proxy to vLLM BF16 TP=4
# Pulls the Core up behind it; the socket holds the client meanwhile.
Requires=crv-core-vllm-27b-bf16.service
After=crv-core-vllm-27b-bf16.service

[Service]
# simple, NOT notify: systemd-socket-proxyd never calls sd_notify, so under
# Type=notify systemd killed the proxy at the 90 s start timeout and the socket
# respawned it — every model call in flight at that moment died with EOF
# ("model call failed — retrying", every ~92 s, 2026-09-04). Readiness of the
# Core behind it is already gated by the Core unit's ExecStartPost.
Type=simple
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=infinity 127.0.0.1:18031
PrivateTmp=no
