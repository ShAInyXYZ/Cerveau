      "tags": [],
      "id": "strip",
      "kind": "ui",
      "label": "Plan strip",
      "sublabel": "a PROGRESS surface · above the composer",
      "note": "Renders only when store.report is non-null. Archives itself once every step reads done, and remembers that in localStorage per plan id — so a plan that arrives ALREADY complete is hidden the instant it appears.",
      "frame": "show",
      "tech": "Svelte 5",
      "status": "wip",
