      "flags": [
        {
          "id": "f1",
          "kind": "issue",
          "title": "Socket activation can wake this Core while its weights are unreachable",
          "note": "The local copy of the BF16 weights was deleted on 2026-09-04 after the NAS copy was verified, so MODEL now points into /mnt/nas-personal. Nothing in the unit checks that the SMB mount is up. The socket answers on :18030 regardless, the proxy pulls the Core, and vLLM fails on a missing path after the caller has already waited — or worse, the mount is up but routed through Tailscale at 4 MB/s and a 55.6 GB load crawls instead of failing. Neither case is distinguishable from a slow cold start at the panel.",
          "fix": "Give the Core unit a RequiresMountsFor=/mnt/nas-personal so systemd refuses to start it without the mount, and add an ExecStartPre that fails if the route to the NAS goes through the tailnet interface rather than the LAN.",
          "by": "agent",
          "at": "2026-09-04T19:54:42.485Z"
        }
      ]
